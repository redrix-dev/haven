{
  "name": "haven-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.1 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "preflight": "node ../../tooling/scripts/mobile/preflight.mjs --strict",
    "dev:metro": "npm run preflight && expo start --dev-client",
    "dev:metro:clear": "npm run preflight && expo start --dev-client --clear",
    "run:ios:simulator": "npm run preflight && expo run:ios",
    "run:ios:device": "npm run preflight && expo run:ios --device",
    "run:android": "npm run preflight && expo run:android",
    "native:prebuild": "npm run preflight && expo prebuild",
    "eas:build": "npm run preflight && npx eas-cli build",
    "eas:submit": "npm run preflight && npx eas-cli submit",
    "eas:credentials": "npm run preflight && npx eas-cli credentials",
    "typecheck": "tsc --noEmit",
    "bundle:check": "npm run preflight && expo export -p ios --no-minify --no-bytecode --clear --output-dir ../../dist/mobile-bundle-check",
    "check:uniwind": "node ../../tooling/scripts/mobile/check-uniwind-theme-usage.mjs",
    "doctor": "node ../../tooling/scripts/mobile/doctor.mjs",
    "revalidate:ios-delegate": "node ../../tooling/scripts/mobile/revalidate-ios-delegate.mjs",
    "start": "npm run dev:metro",
    "start:clear": "npm run dev:metro:clear",
    "ios": "npm run run:ios:simulator",
    "ios:device": "npm run run:ios:device",
    "android": "npm run run:android",
    "prebuild": "npm run native:prebuild",
    "postinstall": "patch-package && node ../../tooling/scripts/mobile/patch-expo-cli-lockdown-debug.mjs"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^3.1.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "^150.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/virtualized-lists": "0.88.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@rn-primitives/accordion": "^1.4.0",
    "@rn-primitives/alert-dialog": "^1.4.0",
    "@rn-primitives/aspect-ratio": "^1.4.0",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/checkbox": "^1.4.0",
    "@rn-primitives/collapsible": "^1.4.0",
    "@rn-primitives/context-menu": "^1.4.0",
    "@rn-primitives/dialog": "^1.4.0",
    "@rn-primitives/dropdown-menu": "^1.4.0",
    "@rn-primitives/hover-card": "^1.4.0",
    "@rn-primitives/label": "^1.4.0",
    "@rn-primitives/menubar": "^1.4.0",
    "@rn-primitives/popover": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/progress": "^1.4.0",
    "@rn-primitives/radio-group": "^1.4.0",
    "@rn-primitives/select": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@rn-primitives/switch": "^1.4.0",
    "@rn-primitives/tabs": "^1.4.0",
    "@rn-primitives/toggle": "^1.4.0",
    "@rn-primitives/toggle-group": "^1.4.0",
    "@rn-primitives/tooltip": "^1.4.0",
    "@supabase/supabase-js": "^2.95.3",
    "@supersami/rn-foreground-service": "^2.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-brightness": "~58.0.2",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "expo-video": "~58.0.13",
    "livekit-client": "^2.20.0",
    "lucide-react-native": "^1.16.0",
    "punycode": "^2.3.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-callkeep": "^4.6.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-enriched-markdown": "^0.5.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.21.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-voip-push-notification": "^3.3.3",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uniwind": "^1.6.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-reusables/cli": "^0.7.1",
    "@types/node": "~22.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "expo-doctor": "^1.18.0",
    "patch-package": "^8.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "@supersami/rn-foreground-service": false,
    "fsevents@2.3.3": true
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "react-native-callkeep",
          "react-native-voip-push-notification",
          "react-native-keyboard-controller",
          "@supersami/rn-foreground-service"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
